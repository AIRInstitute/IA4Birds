{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    //"noUnusedLocals": true,
    //"noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Comprobaciones que se han cambiado de "true" a "false" para el despliegue, cambiar a "true" en caso de que sea necesario para desarrollo
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
